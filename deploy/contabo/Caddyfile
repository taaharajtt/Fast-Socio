# Fast Socio — production origin (fastsocio.online).
#
# Certificates for the apex and www are obtained and renewed over HTTP-01 with
# no manual provisioning. www redirects to the apex so there is exactly one
# canonical origin: two live origins would split auth cookies and make the
# Server Actions origin check harder to reason about.
#
# The pre-DNS test origin (169-58-149-230.sslip.io) was REMOVED in perf audit
# 6.2, per the cleanup step this file always carried. It was a second live
# origin serving the whole app, holding its own certificate, and splitting
# cookies with the real domain. `next.config.ts` no longer allow-lists it for
# Server Actions either — the two must be removed together, or writes would
# still be accepted from a host we no longer serve.

{
	# Let's Encrypt expiry notices. Must be a real mailbox.
	email admin@fastsocio.online

	# Access logs go to stdout so `docker compose logs` is the single place to
	# look, and Docker's json-file rotation (set in compose) bounds them.
	#
	# JSON, not `console` (perf audit 6.1). The console format writes prose with
	# no latency field, so per-route p50/p95 could not be computed at all — the
	# audit had to reason about the 8.8s Home tail from application code instead
	# of measuring it. JSON emits `duration`, `status`, `size`, `uri` and the
	# request headers as structured fields, which is what makes the monitoring
	# in §11 of the audit a `jq` one-liner instead of guesswork.
	#
	# ON CREDENTIALS IN LOGS — this is the reason the old comment forbade header
	# logging, and it still governs. Caddy redacts `Cookie`, `Set-Cookie`,
	# `Authorization` and `Proxy-Authorization` from access logs UNLESS the
	# `servers { log_credentials }` global option is switched on. It is NOT set
	# here and MUST NOT BE: auth cookies and magic-link tokens travel in those
	# headers and must never reach disk. Verify after deploying by grepping one
	# log line for `sb-` (the Supabase cookie prefix) — see the runbook.
	log {
		output stdout
		format filter {
			wrap json
			fields {
				# Explicitly deleted, not merely relied upon. Caddy already
				# redacts these unless `servers { log_credentials }` is set —
				# which is NOT set and must never be — but auth cookies and
				# magic-link tokens are exactly the thing that must never reach
				# disk, so the guarantee is made twice rather than inherited.
				request>headers>Cookie delete
				request>headers>Authorization delete
				resp_headers>Set-Cookie delete
				# Noise: high-cardinality and never used in any query below.
				request>headers>Accept delete
				request>headers>Accept-Encoding delete
				request>headers>Accept-Language delete
				request>tls delete
			}
		}
	}

	# Behind Cloudflare (caching plan, Phase 3). Without this, {remote_host}
	# is a CLOUDFLARE edge IP, so the access log attributes every request to
	# the proxy and the app records Cloudflare IPs in Settings -> Security.
	# Ranges are Cloudflare's published list; re-fetch if they change.
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers Cf-Connecting-Ip X-Forwarded-For
	}
}

fastsocio.online {
	encode zstd gzip

	# Inherits the global filter above (credentials deleted, noise dropped) and
	# keeps `duration`, `status`, `size`, `uri`, `method` plus the two headers
	# the measurements rely on: Next-Router-Prefetch (RSC/prefetch share) and
	# RSC (navigation classification).
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>headers>Cookie delete
				request>headers>Authorization delete
				resp_headers>Set-Cookie delete
				request>headers>Accept delete
				request>headers>Accept-Encoding delete
				request>headers>Accept-Language delete
				request>tls delete
			}
		}
	}

	# Image transforms. Served from our own origin rather than exposing the
	# imgproxy container directly: it keeps images same-origin (so the CSP does
	# not need another host), and imgproxy is never publicly reachable except
	# through this path.
	#
	# handle_path strips the /img prefix, so /img/insecure/rs:fit:… arrives at
	# imgproxy as /insecure/rs:fit:… — which is the URL shape lib/image.ts and
	# the next/image loader build.
	#
	# This points at the imgcache (nginx) container, NOT imgproxy directly:
	# imgproxy has no result cache, so every cold viewer re-rendered the same
	# derivative. See imgcache.conf.
	handle_path /img/* {
		reverse_proxy imgcache:80 {
			# Renders are deterministic and content-addressed by their options,
			# so a slow first byte is a cache miss, not a stalled stream.
			transport http {
				read_timeout 30s
				write_timeout 30s
			}
		}
		# Derivatives never change for a given URL: the source objects are
		# written once under a token-bearing path and never overwritten.
		header Cache-Control "public, max-age=31536000, immutable"
	}

	# Build assets, served from disk across deploys (perf audit 6.3).
	#
	# THE PROBLEM THIS SOLVES: a deploy is `docker compose up -d app`, which
	# REPLACES the container. `.next/static` lives inside the image, so the
	# previous build's chunks stop existing the instant the new container binds
	# — and any client mid-session 404s on the assets its already-loaded HTML
	# references. `deploymentId` (Phase 1) turns that into a hard reload rather
	# than a broken page; this closes the window itself.
	#
	# The app container copies `.next/static` into this shared volume on start
	# (see the CMD in Dockerfile), so it accumulates the last few builds. Chunks
	# are content-hashed, so old and new coexist with no possibility of
	# collision. Pruning is a periodic chore, not a correctness concern — see
	# the runbook.
	#
	# `handle`, NOT `handle_path`: the prefix must survive, because if the file
	# is absent the request falls through to the app and the app needs the
	# original URL. `root * /srv` therefore resolves /_next/static/chunks/x.js
	# to /srv/_next/static/chunks/x.js, which is where the volume is mounted.
	#
	# `route` forces the directives to run in written order. Without it Caddy
	# applies its own directive ordering, in which reverse_proxy sorts BEFORE
	# file_server, and every request would skip the disk entirely.
	#
	# `pass_thru` is the safety valve and the reason this change is safe to ship
	# without being able to test it here: if the volume is empty, unmounted, or
	# the copy failed, file_server declines instead of returning 404 and the
	# request is proxied to the app exactly as it is today. The worst case is
	# the current behaviour, not an outage.
	handle /_next/static/* {
		route {
			root * /srv
			file_server {
				pass_thru
			}
			reverse_proxy app:3000 {
				flush_interval -1
				header_up Host {host}
				header_up X-Forwarded-Host {host}
				header_up X-Forwarded-Proto {scheme}
				header_up X-Real-IP {client_ip}
			}
		}
		# Next sets this itself when IT serves the file; when Caddy serves it
		# from disk nothing else would, and these URLs are content-hashed.
		header Cache-Control "public, max-age=31536000, immutable"
	}

	reverse_proxy app:3000 {
		# Streaming is not optional: Cache Components/PPR ships a static shell
		# and streams the rest. Buffering here silently destroys that.
		flush_interval -1

		# RIDE OUT A DEPLOY INSTEAD OF 502-ing THROUGH IT.
		#
		# `docker compose up -d app` replaces the container, and for the ~9
		# seconds until its healthcheck passes there is nothing listening on
		# app:3000. Without this, every request in that window is answered 502.
		# Measured on 2026-08-31: 78 of the day's 502s fell inside the single
		# hour in which the app container was recreated four times, and none
		# outside it — i.e. essentially all of them were deploy-induced and
		# avoidable.
		#
		# `lb_try_duration` makes Caddy keep retrying the upstream for up to 15s
		# before giving up, so a client mid-deploy waits a moment instead of
		# seeing an error. 15s comfortably covers the observed 9s restart while
		# staying well under the 300s transport timeouts below, so a genuinely
		# dead upstream still fails rather than hanging.
		#
		# This only affects establishing the connection. A request already being
		# streamed is not retried, so it cannot duplicate a Server Action.
		#
		# CARRIED IN THIS FILE SINCE THE PERF AUDIT BUT NEVER APPLIED TO THE LIVE
		# ~/fastsocio-app/Caddyfile until 2026-09-02 — a diff of the two during the
		# Cloudflare cutover found them absent there, so every deploy in between
		# was unprotected. Check both files, not just this one.
		lb_try_duration 15s
		lb_try_interval 250ms

		# Preserve what Next.js needs to reconstruct absolute URLs. Caddy sets
		# X-Forwarded-For/Proto/Host by default; Host is made explicit because
		# the auth routes build redirects from the request origin.
		header_up Host {host}
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Real-IP {client_ip}

		# Long-lived connections. Supabase Realtime is browser-direct and never
		# passes through here, but RSC streaming and Server Action responses can
		# legitimately stay open, so no aggressive read timeout is set.
		transport http {
			read_timeout 300s
			write_timeout 300s
		}
	}

	# No X-Robots-Tag here: this origin IS meant to be indexed. The app sets its
	# own CSP/HSTS via next.config.ts — do not duplicate them here.
	header -Server
}

# www redirects to the apex rather than serving a second copy. Caddy still
# obtains a certificate for it, so https://www.fastsocio.online is valid and
# does not warn before redirecting.
www.fastsocio.online {
	redir https://fastsocio.online{uri} permanent
}

# No catch-all site block is defined on purpose. Caddy only answers for the
# hostnames above; a request arriving by raw IP or an unexpected Host has no
# matching site and no certificate, so it is refused. Adding an explicit
# `:443` block here would fight Automatic HTTPS for the TLS handshake.

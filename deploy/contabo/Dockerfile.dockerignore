# Build context hygiene. Keeping secrets and local state out of the image is
# the point here, not just build speed.
.git
.github
node_modules
.next
out
coverage
test-results
playwright-report
blob-report
playwright/.cache

# Never ship developer credentials into a build context.
.env
.env.*
!.env.example
.vercel

# Local scratch / docs / assets that have no business in a runtime image.
*.md
!README.md
Refactor/
responsive/
tests/
*.png
*.jpg
*.jpeg
*.docx
.dock-probe.mjs
.dock-profile-probe.mjs
.sa-audit.mjs
dock-report.txt
build-output.txt
